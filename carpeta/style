    border-radius: 6px;
    border: 1px solid #000000;
    background-color: #e3ceaa;
    color: rgb(0, 0, 0);
    font-size: 1rem;
    text-align: center;
}

.checkout-summary {
    margin-top: 30px;
    border-top: 2px solid #e7c282;
    padding-top: 20px;
    text-align: center;
}

#total-price {
    color: #e50914;
}

.btn-checkout {
