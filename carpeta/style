.candy-shop-container{
    background-color: #fff5f5;
    border-radius: 12px;
    padding: 30px;
    max-width: 500px;   
    width: 100%;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    max-width: 500px;        
    width: 100%;
    margin: 40px auto;
}
h1{
    color:#e50914;
    margin-bottom:5px;

}
.product-combo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #fff5da;
    padding: 15px;
    margin: 15px 0;
    border-radius: 8px;
    border: 1px solid #3d3d3d;
}

.product-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.product-icon {
    font-size: 2rem;
}

.product-info h3 {
    margin: 0;
    font-size: 1.1rem;
}

.price {
    margin: 5px 0 0 0;
    color: #aaaaaa;
    font-weight: bold;
}

.quantity-input {
    width: 60px;
